generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  aboutMe          String?
  twoFactorEnabled Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactor        TwoFactor[]
  workspaceMembers WorkspaceMember[]
  listMembers      ListMember[]
  guestAccess      Guest[]
  starredLists     Starred[]
  createdItems     Item[]           @relation("ItemCreator")
  itemAssignments  ItemAssignee[]
  uploadedAttachments Attachment[]
  authoredNotes    Note[]         @relation("NoteAuthor")
  mentions         Mention[]      @relation("MentionedUser")
  personalNotes    PersonalNote[] @relation("PersonalNoteOwner")
  notifications    Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  mutedNotificationTypes MutedNotificationType[]
  platformRoleAssignments PlatformRoleAssignment[] @relation("PlatformRoleAssignmentUser")
  grantedPlatformRoleAssignments PlatformRoleAssignment[] @relation("PlatformRoleAssignmentGranter")
  revokedPlatformRoleAssignments PlatformRoleAssignment[] @relation("PlatformRoleAssignmentRevoker")
  securityEvents SecurityEvent[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// SHARED is a multi-User Workspace; PERSONAL is a User's single-member
// Personal Space, provisioned automatically on first verified sign-in.
// Both share this table so List/Item modeling doesn't fork, but product
// surfaces must never expose a Personal Space as a Workspace (CONTEXT.md).
enum WorkspaceKind {
  SHARED
  PERSONAL
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id                     String                @id
  name                   String
  kind                   WorkspaceKind         @default(SHARED)
  // List Dashboard's Peer Comparison setting (#58) — off by default,
  // workspace-level, changeable only by a Workspace Owner or Admin
  // (lib/workspace/workspace-peer-comparison.ts).
  peerComparisonEnabled  Boolean               @default(false)
  // A pre-filled Workspace every User is provisioned alongside their
  // Personal Space so they have real-looking content to explore before
  // creating anything of their own (lib/workspace/demo-workspace.ts).
  // Always kind: SHARED — a Demo Workspace is a normal shared Workspace.
  isDemo                 Boolean               @default(false)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  lists                  List[]
  members                WorkspaceMember[]
  invitations            WorkspaceInvitation[]
  labels                 Label[]

  @@map("workspace")
}

model WorkspaceMember {
  id          String        @id
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_member")
}

model WorkspaceInvitation {
  id          String        @id
  workspaceId String
  email       String
  // Only MEMBER or VIEWER are valid invite-time grants; ADMIN/OWNER are
  // never assigned via invitation (see docs/Specs-Planned domain model spec).
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("workspace_invitation")
}

// A List's role ladder is independent of WorkspaceRole (ADR 0009): a
// ListMember row may only reference a User who already holds a
// Workspace-level membership in that List's Workspace — enforced at the
// application layer in lib/list/, since Guest (below) is the only path to
// List access without one.
enum ListMemberRole {
  LEAD
  MEMBER
  VIEWER
}

enum ListStatus {
  ON_TRACK
  ON_HOLD
  COMPLETED
  DROPPED
}

model List {
  id          String       @id
  workspaceId String
  name        String
  description String?
  status      ListStatus   @default(ON_TRACK)
  isInbox     Boolean      @default(false)
  // Soft-delete: archiving never removes data, so restore is always safe
  // (#26). Null means active.
  archivedAt  DateTime?
  // The List view's "Add Rule" grouping-config control (#29) — a validated
  // string (see lib/list/list-sections.ts's isValidGroupBy) rather than a
  // native enum, since the full set of groupable fields depends on Item's
  // not-yet-built schema (#30); only "SECTION" is legal today.
  groupBy     String       @default("SECTION")
  // Board view's own "Group by" (#31) — independent of the List view's
  // groupBy above, since a User may want the two views arranged
  // differently at once. See lib/list/list-board.ts's isValidBoardGroupBy.
  boardGroupBy String      @default("STATE")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ListMember[]
  guests      Guest[]
  starredBy   Starred[]
  sections    Section[]
  items       Item[]
  customFieldDefinitions CustomFieldDefinition[]

  @@index([workspaceId])
  @@map("list")
}

model ListMember {
  id        String         @id
  listId    String
  userId    String
  role      ListMemberRole @default(MEMBER)
  createdAt DateTime       @default(now())
  list      List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
  @@map("list_member")
}

// Read-only access to exactly the List(s) it names, without requiring any
// Workspace-level membership row (unlike ListMember above) — see CONTEXT.md
// Guest and ADR 0009.
model Guest {
  id        String   @id
  listId    String
  userId    String
  createdAt DateTime @default(now())
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
  @@map("guest")
}

// A per-User-per-List flag (CONTEXT.md Starred), not a boolean column on
// List, since it varies by the viewing User.
model Starred {
  id        String   @id
  listId    String
  userId    String
  createdAt DateTime @default(now())
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([listId])
  @@map("starred")
}

model Section {
  id        String   @id
  listId    String
  name      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  items     Item[]

  @@index([listId])
  @@map("section")
}

enum ItemState {
  TO_DO
  IN_PROGRESS
  BLOCKED
  COMPLETE
  ARCHIVED
}

enum ItemPriority {
  LOW
  NORMAL
  HIGH
}

model Item {
  id        String       @id
  listId    String
  // Self-referencing parent supports arbitrary-depth nesting through one
  // mechanism — no separate Subtask concept (#23, #30).
  parentId  String?
  sectionId String?
  title     String
  // Timeline view's date-bar start (#33) — optional and independent of
  // dueDate, which remains the only date required to appear on Timeline.
  startDate DateTime?
  dueDate   DateTime?
  state     ItemState    @default(TO_DO)
  // The state to return to on restore, set by archiveItem() and cleared by
  // restoreItem() (#38) — Item has no separate archivedAt timestamp like
  // List, so "archived" is state === ARCHIVED and this is the only place
  // the prior state survives the overwrite.
  stateBeforeArchive ItemState?
  priority  ItemPriority @default(NORMAL)
  // Required when state is BLOCKED (enforced at the application layer in
  // lib/item/, not at the schema level).
  blockerReason String?
  // Set once at creation; never reassigned as Assignees change — enforced
  // at the application layer in lib/item/, matching Section/List's
  // established convention for this kind of invariant.
  creatorId String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  list      List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  section   Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent    Item?          @relation("ItemHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Item[]         @relation("ItemHierarchy")
  creator   User           @relation("ItemCreator", fields: [creatorId], references: [id])
  assignees ItemAssignee[]
  labels    ItemLabel[]
  customFieldValues CustomFieldValue[]
  // Dependencies where this Item is the blocker/blocked side, respectively
  // (#35).
  blocking  ItemDependency[] @relation("DependencyBlocker")
  blockedBy ItemDependency[] @relation("DependencyBlocked")
  attachments Attachment[]
  notes         Note[]
  personalNotes PersonalNote[]
  notifications Notification[]

  @@index([listId])
  @@index([sectionId])
  @@index([parentId])
  @@map("item")
}

model ItemAssignee {
  id        String   @id
  itemId    String
  userId    String
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId])
  @@map("item_assignee")
}

// Creating a Label is gated (Personal-Space-free / Workspace-Owner-Admin
// in a shared Workspace, mirroring List-creation rights); applying an
// existing Label to an Item is not — any List Member with Item access can
// (#34).
model Label {
  id          String      @id
  workspaceId String
  name        String
  createdAt   DateTime    @default(now())
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       ItemLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("label")
}

model ItemLabel {
  id        String   @id
  itemId    String
  labelId   String
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([itemId, labelId])
  @@index([labelId])
  @@map("item_label")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DROPDOWN
  DATE
}

// Defined per List by a List Lead or Workspace Admin; any List Member can
// set a value on an Item (#34).
model CustomFieldDefinition {
  id        String            @id
  listId    String
  name      String
  type      CustomFieldType
  // DROPDOWN's allowed option strings; unused (empty) for other types.
  options   String[]          @default([])
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  list      List              @relation(fields: [listId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([listId, name])
  @@index([listId])
  @@map("custom_field_definition")
}

model CustomFieldValue {
  id           String                 @id
  itemId       String
  definitionId String
  // Stored as text regardless of the definition's type and
  // parsed/validated against it at the application layer (lib/item/) —
  // avoids a sparse multi-column value table for 4 possible types.
  value        String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  item         Item                   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  definition   CustomFieldDefinition  @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([itemId, definitionId])
  @@index([definitionId])
  @@map("custom_field_value")
}

// A directed link between two Items, including across different Lists —
// purely informational, never changes either Item's lifecycle state
// (#35). blocker "blocks" blocked; blocked "is blocked by" blocker.
model ItemDependency {
  id        String   @id
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   Item     @relation("DependencyBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   Item     @relation("DependencyBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("item_dependency")
}

// A List Member can attach a file to an Item (#39). Metadata + storageKey
// only — lib/item/ never touches file bytes; the Route Handler upload
// transport writes to S3-compatible storage (ADR 0002) and hands this
// model its storageKey. No preview rendering or malware scanning in v1
// (#40); ZIP contents stay download-only.
model Attachment {
  id          String   @id
  itemId      String
  uploaderId  String
  fileName    String
  contentType String
  sizeBytes   Int
  storageKey  String
  createdAt   DateTime @default(now())
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploaderId], references: [id])

  @@index([itemId])
  @@map("attachment")
}

// A team-visible text update on an Item (#37) — Comment/reply/thread are
// deliberately avoided terms per CONTEXT.md's Note entry: no nested replies
// in v1.
model Note {
  id        String    @id
  itemId    String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author    User      @relation("NoteAuthor", fields: [authorId], references: [id])
  mentions  Mention[]
  notifications Notification[]

  @@index([itemId])
  @@map("note")
}

// A `@name` reference to a User inside a Note's body, validated at write
// time (lib/item/) against Users who already have access to the Note's
// Item — mentioning is never itself a grant of access (#37).
model Mention {
  id        String   @id
  noteId    String
  userId    String
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User     @relation("MentionedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
  @@map("mention")
}

// A private, per-User-per-Item planning note (#37) — visible only to its
// owning User and never surfaced on the shared Item, distinct from the
// team-visible Note above.
model PersonalNote {
  id        String   @id
  itemId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation("PersonalNoteOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@map("personal_note")
}

enum NotificationType {
  ASSIGNEE_ADDED
  ASSIGNEE_REMOVED
  NOTE_ADDED
  MENTIONED
  STATE_CHANGED
  DUE_DATE_REMINDER
}

// Delivery record for the Updates surface (CONTEXT.md) — always scoped to
// exactly one recipient, so per-recipient read/bookmarked/archived state
// lives directly on this row rather than a separate shared-state table
// (#41). Created by lib/notification/'s trigger functions on Assignee-list
// change, Note creation (including @Mention resolution), Item lifecycle
// state change, and a due-date-approaching schedule; never edited by any
// other lib/ module.
model Notification {
  id          String            @id
  recipientId String
  type        NotificationType
  itemId      String
  // The User whose action produced this notification; null for the
  // system-triggered DUE_DATE_REMINDER type, which has no actor.
  actorId     String?
  // Set only for NOTE_ADDED/MENTIONED, linking back to the triggering Note.
  noteId      String?
  // Snapshot of the Item's dueDate at DUE_DATE_REMINDER creation time, used
  // by the dedup constraint below so a reminder fires once per approaching
  // deadline rather than once per scheduler run (#41) — null for every
  // other type.
  dueDateAt   DateTime?
  readAt       DateTime?
  bookmarkedAt DateTime?
  archivedAt   DateTime?
  createdAt   DateTime          @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  item      Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  note      Note? @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([recipientId, itemId, type, dueDateAt])
  @@index([recipientId, createdAt])
  @@index([recipientId, type])
  @@map("notification")
}

// A User's opt-out from a NotificationType on the Manage Notifications page
// (#48). Presence of a row means disabled; absence means enabled, so a
// newly added NotificationType defaults to on without a migration or every
// User needing a row for every type (mirrors Starred's presence-only
// pattern). Checked at trigger time in notification-triggers.ts, not just
// filtered out of the Activity list.
model MutedNotificationType {
  id        String           @id
  userId    String
  type      NotificationType
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("muted_notification_type")
}

// Better Auth's email-verification tokens are stateless signed JWTs and are
// never persisted, so the per-email resend cooldown needs its own store.
model VerificationEmailThrottle {
  identifier String   @id
  lastSentAt DateTime @default(now())

  @@map("verification_email_throttle")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model PlatformRoleAssignment {
  id              String    @id
  userId          String
  grantedByUserId String
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  revokedByUserId String?
  user            User      @relation("PlatformRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser   User      @relation("PlatformRoleAssignmentGranter", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedByUser   User?     @relation("PlatformRoleAssignmentRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("platform_role_assignment")
}

model SecurityEvent {
  id        String   @id
  type      String
  userId    String?
  email     String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("security_event")
}

model SecurityNoticeOutbox {
  id             String   @id
  recipient      String
  type           String
  action         String?
  newEmail       String?
  status         String   @default("pending")
  attemptCount   Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  finalFailureAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, finalFailureAt])
  @@map("security_notice_outbox")
}

model SecurityAlertDispatch {
  subject   String   @id
  alertedAt DateTime @default(now())

  @@map("security_alert_dispatch")
}
